Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: truth (/sim/truth)
      Enabled: true
      Topic:
        Value: /sim/truth
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.02
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf1 setpoint
      Enabled: true
      Topic:
        Value: /cf1/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf2 setpoint
      Enabled: true
      Topic:
        Value: /cf2/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf3 setpoint
      Enabled: true
      Topic:
        Value: /cf3/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf4 setpoint
      Enabled: true
      Topic:
        Value: /cf4/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf5 setpoint
      Enabled: true
      Topic:
        Value: /cf5/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: cf6 setpoint
      Enabled: true
      Topic:
        Value: /cf6/setpoint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Shape: Arrow
      Shaft Length: 0.1
      Head Length: 0.05
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Pitch: 0.6
      Yaw: 0.8
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 800
